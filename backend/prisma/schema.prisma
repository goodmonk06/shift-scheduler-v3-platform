// Shift Scheduler SaaS Platform - Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Tenant & User Management
// ============================================

model Tenant {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  plan              SubscriptionPlan   @default(TRIAL)
  status            TenantStatus       @default(ACTIVE)

  // Stripe関連
  stripeCustomerId      String?        @unique
  stripeSubscriptionId  String?        @unique
  subscriptionStatus    SubscriptionStatus?
  currentPeriodEnd      DateTime?

  // プラン制限
  maxFacilities     Int                @default(1)  // trial:1, standard:3, pro:unlimited
  maxStaffPerFacility Int              @default(20) // trial:20, standard:50, pro:unlimited

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  users             User[]
  facilities        Facility[]

  @@map("tenants")
}

enum SubscriptionPlan {
  TRIAL
  STANDARD
  PRO
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  INCOMPLETE
  TRIALING
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  name          String
  role          UserRole       @default(STAFF)

  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // 関連するスタッフレコード（UserがStaffでもある場合）
  staffId       String?        @unique
  staff         Staff?         @relation(fields: [staffId], references: [id])

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  notifications Notification[]
  shiftNotes    ShiftNote[]

  @@index([tenantId])
  @@map("users")
}

enum UserRole {
  ADMIN        // テナント管理者
  MANAGER      // 施設管理者
  STAFF        // 一般スタッフ
}

// ============================================
// Facility & Staff Management
// ============================================

model Facility {
  id              String           @id @default(cuid())
  name            String
  type            FacilityType

  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // 設定
  timezone        String           @default("Asia/Tokyo")
  settings        Json?            // カスタム設定（営業時間など）

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  staff           Staff[]
  shiftPatterns   ShiftPattern[]
  shiftAssignments ShiftAssignment[]
  constraintRules ConstraintRule[]
  departments     Department[]
  shiftTemplates  ShiftTemplate[]
  timeOffPolicies TimeOffPolicy[]

  @@index([tenantId])
  @@map("facilities")
}

enum FacilityType {
  NURSING_HOME     // 介護施設
  RESTAURANT       // 飲食店
  RETAIL           // 小売
  HOSPITAL         // 病院
  OTHER            // その他
}

model Staff {
  id                String           @id @default(cuid())
  employeeNumber    String?          // 従業員番号
  name              String
  email             String?
  phone             String?

  facilityId        String
  facility          Facility         @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  tenantId          String           // マルチテナント用

  // 雇用情報
  employmentType    EmploymentType   @default(FULL_TIME)
  position          String?          // 役職
  skills            String[]         // スキルタグ配列

  // 勤務条件
  maxHoursPerWeek   Int?             // 週最大勤務時間
  maxDaysPerWeek    Int?             // 週最大勤務日数
  preferredDays     Int[]            @default([]) // 希望勤務曜日 (0=日, 1=月, ...)

  isActive          Boolean          @default(true)

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user              User?
  departmentId      String?
  department        Department?      @relation(fields: [departmentId], references: [id])

  shiftAssignments  ShiftAssignment[]
  leaveRequests     LeaveRequest[]
  swapRequestsAsRequester ShiftSwapRequest[] @relation("SwapRequester")
  swapRequestsAsTarget ShiftSwapRequest[] @relation("SwapTarget")
  timeOffBalances   TimeOffBalance[]

  @@index([facilityId])
  @@index([tenantId])
  @@index([departmentId])
  @@map("staff")
}

enum EmploymentType {
  FULL_TIME        // 正社員
  PART_TIME        // パート
  CONTRACT         // 契約社員
  TEMPORARY        // アルバイト
}

// ============================================
// Shift Pattern Management
// ============================================

model ShiftPattern {
  id              String           @id @default(cuid())
  name            String           // 例: "早番", "日勤A", "夜勤入り"
  shortName       String           // 例: "早", "日A", "夜入"
  color           String           @default("#3b82f6") // UI表示用カラーコード

  facilityId      String
  facility        Facility         @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  tenantId        String           // マルチテナント用

  // 勤務時間
  startTime       String           // "09:00" 形式
  endTime         String           // "17:00" 形式
  breakMinutes    Int              @default(0) // 休憩時間（分）

  // 必要人数（デフォルト）
  requiredStaff   Int              @default(1)

  // 必要スキル
  requiredSkills  String[]         @default([])

  sortOrder       Int              @default(0)  // 表示順
  isActive        Boolean          @default(true)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  shiftAssignments ShiftAssignment[]

  @@index([facilityId])
  @@index([tenantId])
  @@map("shift_patterns")
}

// ============================================
// Shift Assignment (実際のシフト)
// ============================================

model ShiftAssignment {
  id              String           @id @default(cuid())

  facilityId      String
  facility        Facility         @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  tenantId        String           // マルチテナント用

  staffId         String
  staff           Staff            @relation(fields: [staffId], references: [id], onDelete: Cascade)

  patternId       String
  pattern         ShiftPattern     @relation(fields: [patternId], references: [id])

  date            DateTime         @db.Date

  // ステータス
  status          AssignmentStatus @default(CONFIRMED)

  // メモ
  note            String?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  swapRequestsAsRequester ShiftSwapRequest[] @relation("SwapRequesterAssignment")
  swapRequestsAsTarget ShiftSwapRequest[] @relation("SwapTargetAssignment")
  notes           ShiftNote[]

  @@unique([staffId, date, patternId]) // 同じスタッフが同日同パターンに複数割当されない
  @@index([facilityId, date])
  @@index([staffId])
  @@index([tenantId])
  @@map("shift_assignments")
}

enum AssignmentStatus {
  DRAFT            // 下書き
  CONFIRMED        // 確定
  PUBLISHED        // 公開済み
}

// ============================================
// Constraint Rules (制約ルール)
// ============================================

model ConstraintRule {
  id              String           @id @default(cuid())
  name            String
  description     String?

  facilityId      String
  facility        Facility         @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  tenantId        String           // マルチテナント用

  // ルールタイプ
  type            ConstraintType

  // ルール設定（JSON）
  // 例: { "maxConsecutiveDays": 5, "minRestHours": 11, etc. }
  config          Json

  priority        Int              @default(1) // 優先度 (1=高, 3=低)
  isActive        Boolean          @default(true)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([facilityId])
  @@index([tenantId])
  @@map("constraint_rules")
}

enum ConstraintType {
  MAX_CONSECUTIVE_DAYS     // 最大連続勤務日数
  MIN_REST_HOURS           // 最小休憩時間
  MAX_HOURS_PER_WEEK       // 週最大勤務時間
  REQUIRED_STAFF_COUNT     // 必要人数
  SKILL_REQUIREMENT        // スキル要件
  PROHIBITED_PATTERN       // 禁止パターン
  CUSTOM                   // カスタムルール
}

// ============================================
// Leave Request (休暇申請)
// ============================================

model LeaveRequest {
  id              String           @id @default(cuid())

  staffId         String
  staff           Staff            @relation(fields: [staffId], references: [id], onDelete: Cascade)

  tenantId        String           // マルチテナント用

  startDate       DateTime         @db.Date
  endDate         DateTime         @db.Date

  type            LeaveType        @default(PAID_LEAVE)
  reason          String?

  status          LeaveStatus      @default(PENDING)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([staffId])
  @@index([tenantId])
  @@map("leave_requests")
}

enum LeaveType {
  PAID_LEAVE       // 有給休暇
  SICK_LEAVE       // 病気休暇
  PERSONAL_LEAVE   // 私用休暇
  OTHER            // その他
}

enum LeaveStatus {
  PENDING          // 承認待ち
  APPROVED         // 承認済み
  REJECTED         // 却下
}

// ============================================
// Department (Phase 3)
// ============================================

model Department {
  id              String           @id @default(cuid())
  name            String
  description     String?

  facilityId      String
  facility        Facility         @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  tenantId        String

  parentId        String?
  parent          Department?      @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children        Department[]     @relation("DepartmentHierarchy")

  managerId       String?

  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  staff           Staff[]

  @@index([facilityId])
  @@index([tenantId])
  @@index([parentId])
  @@map("departments")
}

// ============================================
// Shift Template (Phase 3)
// ============================================

model ShiftTemplate {
  id              String           @id @default(cuid())
  name            String
  description     String?

  facilityId      String
  facility        Facility         @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  tenantId        String

  // テンプレート設定
  recurrenceType  RecurrenceType   @default(WEEKLY)
  config          Json             // 週間パターン、月間パターンなど

  startDate       DateTime?        @db.Date
  endDate         DateTime?        @db.Date

  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([facilityId])
  @@index([tenantId])
  @@map("shift_templates")
}

enum RecurrenceType {
  DAILY
  WEEKLY
  BI_WEEKLY
  MONTHLY
  CUSTOM
}

// ============================================
// Shift Swap Request (Phase 3)
// ============================================

model ShiftSwapRequest {
  id                   String              @id @default(cuid())

  requesterStaffId     String
  requesterStaff       Staff               @relation("SwapRequester", fields: [requesterStaffId], references: [id], onDelete: Cascade)

  requesterAssignmentId String
  requesterAssignment   ShiftAssignment    @relation("SwapRequesterAssignment", fields: [requesterAssignmentId], references: [id])

  targetStaffId        String?
  targetStaff          Staff?              @relation("SwapTarget", fields: [targetStaffId], references: [id])

  targetAssignmentId   String?
  targetAssignment     ShiftAssignment?    @relation("SwapTargetAssignment", fields: [targetAssignmentId], references: [id])

  tenantId             String

  reason               String?
  status               SwapStatus          @default(PENDING)

  approvedBy           String?
  approvedAt           DateTime?
  rejectedReason       String?

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([requesterStaffId])
  @@index([targetStaffId])
  @@index([tenantId])
  @@index([status])
  @@map("shift_swap_requests")
}

enum SwapStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

// ============================================
// Notification (Phase 3)
// ============================================

model Notification {
  id              String              @id @default(cuid())

  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenantId        String

  type            NotificationType
  title           String
  message         String

  data            Json?               // 追加データ

  isRead          Boolean             @default(false)
  readAt          DateTime?

  createdAt       DateTime            @default(now())

  @@index([userId, isRead])
  @@index([tenantId])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  SHIFT_ASSIGNED
  SHIFT_CHANGED
  SHIFT_CANCELLED
  SWAP_REQUESTED
  SWAP_APPROVED
  SWAP_REJECTED
  LEAVE_APPROVED
  LEAVE_REJECTED
  SCHEDULE_PUBLISHED
  SYSTEM_ALERT
}

// ============================================
// Audit Log (Phase 3)
// ============================================

model AuditLog {
  id              String           @id @default(cuid())

  tenantId        String

  userId          String?
  userName        String?

  action          AuditAction
  entityType      String           // "Staff", "ShiftAssignment", etc.
  entityId        String

  changes         Json?            // Before/after values
  metadata        Json?            // Additional context

  ipAddress       String?
  userAgent       String?

  createdAt       DateTime         @default(now())

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}

enum AuditAction {
  CREATED
  UPDATED
  DELETED
  APPROVED
  REJECTED
  PUBLISHED
  ARCHIVED
}

// ============================================
// Shift Note (Phase 3)
// ============================================

model ShiftNote {
  id              String           @id @default(cuid())

  assignmentId    String
  assignment      ShiftAssignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  authorId        String
  author          User             @relation(fields: [authorId], references: [id])

  tenantId        String

  content         String
  isInternal      Boolean          @default(false) // 内部メモか外部公開か

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([assignmentId])
  @@index([tenantId])
  @@map("shift_notes")
}

// ============================================
// Time Off Policy (Phase 3)
// ============================================

model TimeOffPolicy {
  id                    String           @id @default(cuid())
  name                  String
  description           String?

  facilityId            String
  facility              Facility         @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  tenantId              String

  leaveType             LeaveType

  // ポリシー設定
  annualAllowance       Int              // 年間付与日数
  accrualRate           Float?           // 月次付与率
  carryoverLimit        Int?             // 繰越上限
  requiresApproval      Boolean          @default(true)
  minimumNoticeDays     Int              @default(7)

  isActive              Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  balances              TimeOffBalance[]

  @@index([facilityId])
  @@index([tenantId])
  @@map("time_off_policies")
}

model TimeOffBalance {
  id              String           @id @default(cuid())

  staffId         String
  staff           Staff            @relation(fields: [staffId], references: [id], onDelete: Cascade)

  policyId        String
  policy          TimeOffPolicy    @relation(fields: [policyId], references: [id], onDelete: Cascade)

  tenantId        String

  year            Int
  balance         Float            // 残日数
  used            Float            @default(0)
  accrued         Float            @default(0)
  carriedOver     Float            @default(0)

  updatedAt       DateTime         @updatedAt

  @@unique([staffId, policyId, year])
  @@index([staffId])
  @@index([tenantId])
  @@map("time_off_balances")
}
